 <!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Padelschema - Rooster & Chat</title>
    <!-- Firebase App (compat) -->
    <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-app-compat.js"></script>
    <!-- Firebase Realtime Database -->
    <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-database-compat.js"></script>
    
    <style>
        :root {
            --bg-color: #0b0f19;
            --card-bg: #111827;
            --card-border: #1f2937;
            --card-border-glow: #374151;
            --btn-bg: #263345;
            --btn-hover: #32445c;
            --text-main: #f9fafb;
            --text-muted: #9ca3af;
            --accent-blue: #38bdf8;
            --accent-orange: #fb923c;
            --accent-green: #34d399;
            --accent-green-bg: rgba(52, 211, 153, 0.1);
            --danger: #f87171;
            --danger-bg: rgba(248, 113, 113, 0.1);
            --main-glow: 0 16px 60px rgba(52, 211, 153, 0.28), 0 0 50px rgba(52, 211, 153, 0.15);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            padding: 16px;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .container {
            width: 100%;
            max-width: 768px;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        header {
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            padding: 20px;
            border-radius: 14px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 16px;
            box-shadow: var(--main-glow);
        }

        .header-top {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 12px;
            width: 100%;
        }

        h1 {
            font-size: 1.7rem;
            font-weight: 700;
            color: var(--accent-green);
            letter-spacing: -0.025em;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        /* Actieve status van spelers */
        .status-card {
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            padding: 14px 20px;
            border-radius: 12px;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .status-title {
            font-size: 0.85rem;
            color: var(--text-muted);
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .status-list {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }

        .status-badge {
            background: var(--bg-color);
            border: 1px solid var(--card-border);
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 0.85rem;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .status-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--text-muted);
        }

        .status-dot.online {
            background: var(--accent-green);
            box-shadow: 0 0 8px var(--accent-green);
        }

        .week-card {
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: 14px;
            overflow: hidden;
            box-shadow: 0 4px 20px rgba(0,0,0,0.3);
            transition: border-color 0.2s;
        }

        .week-card:hover {
            border-color: var(--card-border-glow);
        }

        .week-header {
            background: rgba(255, 255, 255, 0.02);
            padding: 14px 20px;
            font-weight: 600;
            font-size: 1rem;
            color: var(--accent-blue);
            border-bottom: 1px solid var(--card-border);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .match-row {
            padding: 16px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid var(--card-border);
        }

        .match-row:last-child {
            border-bottom: none;
        }

        .match-info {
            flex-grow: 1;
        }

        .match-title {
            font-weight: 600;
            color: var(--text-muted);
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-bottom: 6px;
        }

        .players-list {
            font-size: 1.05rem;
            color: var(--text-main);
            font-weight: 500;
        }

        .btn-edit {
            background-color: var(--btn-bg);
            color: var(--text-main);
            border: 1px solid var(--card-border);
            padding: 8px 14px;
            border-radius: 8px;
            cursor: pointer;
            font-size: 0.85rem;
            font-weight: 600;
            transition: background 0.2s, border-color 0.2s;
        }

        .btn-edit:hover {
            background-color: var(--btn-hover);
            border-color: var(--accent-blue);
        }

        /* Modal Popup */
        .modal {
            display: none;
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0, 0, 0, 0.7);
            backdrop-filter: blur(4px);
            justify-content: center;
            align-items: center;
            z-index: 1000;
            padding: 16px;
        }

        .modal-content {
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            padding: 24px;
            border-radius: 16px;
            width: 100%;
            max-width: 400px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.5);
        }

        .modal-content h3 {
            margin-top: 0;
            color: var(--accent-green);
            font-size: 1.25rem;
            margin-bottom: 16px;
        }

        .player-select-group {
            margin-bottom: 14px;
        }

        .player-select-group label {
            display: block;
            font-size: 0.8rem;
            color: var(--text-muted);
            margin-bottom: 4px;
            font-weight: 600;
        }

        .player-select-group select, .player-select-group input {
            width: 100%;
            padding: 10px;
            background: var(--bg-color);
            color: var(--text-main);
            border: 1px solid var(--card-border);
            border-radius: 8px;
            font-size: 0.95rem;
            outline: none;
        }

        .modal-buttons {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            margin-top: 20px;
        }

        .btn-cancel {
            background-color: transparent;
            color: var(--text-muted);
            border: 1px solid var(--card-border);
            padding: 9px 16px;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 600;
        }

        .btn-cancel:hover {
            color: var(--text-main);
            border-color: var(--text-muted);
        }

        .btn-save {
            background-color: var(--accent-green);
            color: #0b0f19;
            border: none;
            padding: 9px 16px;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 700;
        }

        .btn-save:hover {
            opacity: 0.9;
        }
    </style>
</head>
<body>

<div class="container">
    <header>
        <div class="header-top">
            <h1>🎾 Padelschema</h1>
        </div>
    </header>

    <!-- Actieve status van spelers -->
    <div class="status-card">
        <div class="status-title">Spelers Status</div>
        <div id="statusList" class="status-list">Laden status...</div>
    </div>

    <!-- Hier komt het dynamische schema -->
    <div id="scheduleContainer" style="display: flex; flex-direction: column; gap: 16px;">Laden van schema...</div>
</div>

<!-- Modal voor wijzigen spelers -->
<div id="replaceModal" class="modal">
    <div class="modal-content">
        <h3 id="modalSubTitle">Spelers wijzigen</h3>
        
        <div class="player-select-group">
            <label>Speler 1</label>
            <select id="p0Select" onchange="checkCustomInputs()"></select>
            <input type="text" id="p0Custom" placeholder="Naam invaller" style="display:none; margin-top:6px;">
        </div>
        <div class="player-select-group">
            <label>Speler 2</label>
            <select id="p1Select" onchange="checkCustomInputs()"></select>
            <input type="text" id="p1Custom" placeholder="Naam invaller" style="display:none; margin-top:6px;">
        </div>
        <div class="player-select-group">
            <label>Speler 3</label>
            <select id="p2Select" onchange="checkCustomInputs()"></select>
            <input type="text" id="p2Custom" placeholder="Naam invaller" style="display:none; margin-top:6px;">
        </div>
        <div class="player-select-group">
            <label>Speler 4</label>
            <select id="p3Select" onchange="checkCustomInputs()"></select>
            <input type="text" id="p3Custom" placeholder="Naam invaller" style="display:none; margin-top:6px;">
        </div>

        <div class="modal-buttons">
            <button class="btn-cancel" onclick="closeModal()">Annuleren</button>
            <button class="btn-save" onclick="confirmReplacement()">Opslaan</button>
        </div>
    </div>
</div>

<script>
    // --- FIREBASE CONFIGURATIE ---
    const firebaseConfig = {
        databaseURL: "https://padelschema-default-rtdb.europe-west1.firebasedatabase.app/"
    };
    
    if (!firebase.apps.length) {
        firebase.initializeApp(firebaseConfig);
    }
    const db = firebase.database();

    // Vaste spelersgroep
    const basePlayers = ["Marcel", "Mark", "Ronald", "Sander", "Dennis", "Robert"];
    const currentUserName = "Robert"; // Huidige sessie gebruiker

    // Jouw juiste template (waarin Ronald en Robert in week 3 op dinsdag samen spelen)
    const defaultTemplate = [
        { dinsdag: ["Ronald", "Sander", "Dennis", "Marcel"], donderdag: ["Mark", "Robert", "Marcel", "Sander"] },
        { dinsdag: ["Marcel", "Mark", "Dennis", "Robert"], donderdag: ["Ronald", "Sander", "Mark", "Dennis"] },
        { dinsdag: ["Ronald", "Robert", "Marcel", "Sander"], donderdag: ["Mark", "Marcel", "Dennis", "Ronald"] },
        { dinsdag: ["Marcel", "Mark", "Ronald", "Sander"], donderdag: ["Dennis", "Robert", "Marcel", "Ronald"] },
        { dinsdag: ["Mark", "Dennis", "Sander", "Robert"], donderdag: ["Marcel", "Sander", "Ronald", "Dennis"] },
        { dinsdag: ["Sander", "Ronald", "Robert", "Mark"], donderdag: ["Marcel", "Dennis", "Mark", "Sander"] }
    ];

    let liveOverrides = {};
    let allStatuses = {};

    // Initialiseer bij laden
    document.addEventListener('DOMContentLoaded', () => {
        // Luister naar live updates uit Firebase voor schema
        db.ref('scheduleOverrides').on('value', (snapshot) => {
            liveOverrides = snapshot.val() || {};
            renderSchedule();
        });

        // Luister naar online statussen
        db.ref('status').on('value', (snapshot) => {
            allStatuses = snapshot.val() || {};
            renderStatuses();
        });

        // Activeer eigen online status
        setupOnlinePresence();
    });

    // --- ONLINE STATUS LOGICA ---
    function setupOnlinePresence() {
        const userStatusRef = db.ref(`status/${currentUserName}`);

        const isOfflineForDatabase = {
            state: "offline",
            lastChanged: firebase.database.ServerValue.TIMESTAMP
        };

        const isOnlineForDatabase = {
            state: "online",
            lastChanged: firebase.database.ServerValue.TIMESTAMP
        };

        db.ref('.info/connected').on('value', (snapshot) => {
            if (snapshot.val() === false) return;

            userStatusRef.onDisconnect().set(isOfflineForDatabase).then(() => {
                userStatusRef.set(isOnlineForDatabase);
            });
        });
    }

    function formatLastSeen(lastChanged) {
        if (!lastChanged) return "Offline";
        const diffMs = Date.now() - lastChanged;
        const diffMins = Math.floor(diffMs / (1000 * 60));
        const diffHours = Math.floor(diffMins / 60);
        const diffDays = Math.floor(diffHours / 24);

        if (diffMins < 2) return "Online";
        if (diffMins < 60) return `${diffMins} min geleden`;
        if (diffHours < 24) return `${diffHours} uur geleden`;
        return `${diffDays} dag(en) geleden`;
    }

    function renderStatuses() {
        const container = document.getElementById('statusList');
        if (!container) return;
        let html = '';

        basePlayers.forEach(player => {
            const statusData = allStatuses[player];
            const isOnline = statusData && statusData.state === "online" && (Date.now() - statusData.lastChanged < 120000);
            const statusText = isOnline ? "Online" : formatLastSeen(statusData ? statusData.lastChanged : null);
            const dotClass = isOnline ? "online" : "";

            html += `
                <div class="status-badge">
                    <span class="status-dot ${dotClass}"></span>
                    <span>${player}: <strong style="color:var(--text-main);">${statusText}</strong></span>
                </div>
            `;
        });

        container.innerHTML = html;
    }

    // Jouw slimme functie om de automatische cyclusweek te berekenen (pas na donderdag omklappen)
    const berekenHuidigeCyclusWeek = () => {
        const startDatum = new Date('2026-09-07T00:00:00'); // Jouw startpunt
        const nu = new Date();

        const verschilInMs = nu - startDatum;
        if (verschilInMs < 0) return 0; // Index 0 voor de start

        const extraOffsetMs = 1000 * 60 * 60 * 24 * 3; // 3 dagen extra zodat hij na donderdag omklapt
        const aangepastVerschil = verschilInMs + extraOffsetMs;

        const verschilInWeken = Math.floor(aangepastVerschil / (1000 * 60 * 60 * 24 * 7));
        const huidigeWeekIndex = verschilInWeken % 6;

        return huidigeWeekIndex;
    };

    // Hulpfunctie om ISO weeknummer te berekenen
    function getWeekNumber(d) {
        d = new Date(Date.UTC(d.getFullYear(), d.getMonth(), d.getDate()));
        d.setUTCDate(d.getUTCDate() + 4 - (d.getUTCDay()||7));
        var yearStart = new Date(Date.UTC(d.getUTCFullYear(),0,1));
        var weekNo = Math.ceil((((d - yearStart) / 86400000) + 1)/7);
        return weekNo;
    }

    function formatDateDDMMYY(date) {
        const d = String(date.getDate()).padStart(2, '0');
        const m = String(date.getMonth() + 1).padStart(2, '0');
        const y = String(date.getFullYear()).slice(-2);
        return `${d}-${m}-${y}`;
    }

    // Bepaal de actieve weken om te tonen
    function getActiveDisplayWeeks() {
        const startBaseDate = new Date(2026, 8, 7); // Maandag 7 september 2026
        let weeks = [];

        let startIndex = berekenHuidigeCyclusWeek();

        for (let i = 0; i < 6; i++) {
            const currentCycleIndex = (startIndex + i) % defaultTemplate.length;
            const weekIndex = currentCycleIndex + 1;
            
            const diDate = new Date(startBaseDate);
            diDate.setDate(startBaseDate.getDate() + ((startIndex + i) * 7));
            const doDate = new Date(diDate);
            doDate.setDate(diDate.getDate() + 3); // Donderdag is 3 dagen na de maandag van die week

            const currentTemplateWeek = defaultTemplate[currentCycleIndex];

            // Check of er Firebase overrides zijn voor deze week
            let dinsdagPlayers = currentTemplateWeek.dinsdag;
            let donderdagPlayers = currentTemplateWeek.donderdag;

            if (liveOverrides[weekIndex]) {
                if (liveOverrides[weekIndex].dinsdag) dinsdagPlayers = liveOverrides[weekIndex].dinsdag;
                if (liveOverrides[weekIndex].donderdag) donderdagPlayers = liveOverrides[weekIndex].donderdag;
            }

            weeks.push({
                weekIndex,
                weekNumber: getWeekNumber(diDate),
                dinsdagDateStr: formatDateDDMMYY(diDate),
                donderdagDateStr: formatDateDDMMYY(doDate),
                dinsdag: dinsdagPlayers,
                donderdag: donderdagPlayers
            });
        }
        return weeks;
    }

    // Teken het schema op het scherm
    function renderSchedule() {
        const container = document.getElementById('scheduleContainer');
        const weeks = getActiveDisplayWeeks();
        let html = '';

        weeks.forEach(w => {
            html += `
                <div class="week-card">
                    <div class="week-header">
                        <span>Week ${w.weekNumber} (Cyclus Week ${w.weekIndex})</span>
                    </div>
                    <div class="match-row">
                        <div class="match-info">
                            <div class="match-title">Dinsdag (${w.dinsdagDateStr})</div>
                            <div class="players-list">${w.dinsdag.join(', ')}</div>
                        </div>
                        <button class="btn-edit" onclick="openReplaceModal(${w.weekIndex}, 'dinsdag')">Wijzig</button>
                    </div>
                    <div class="match-row">
                        <div class="match-info">
                            <div class="match-title">Donderdag (${w.donderdagDateStr})</div>
                            <div class="players-list">${w.donderdag.join(', ')}</div>
                        </div>
                        <button class="btn-edit" onclick="openReplaceModal(${w.weekIndex}, 'donderdag')">Wijzig</button>
                    </div>
                </div>
            `;
        });

        container.innerHTML = html;
    }

    // --- MODAL & OVERRIDE LOGICA ---
    let currentEditingWeek = null;
    let currentEditingDay = null;

    window.openReplaceModal = function(weekIndex, day) {
        currentEditingWeek = weekIndex;
        currentEditingDay = day;

        document.getElementById("modalSubTitle").innerText = `Cyclus Week ${weekIndex} - ${day === 'dinsdag' ? 'Dinsdag' : 'Donderdag'}`;
        
        const activeWeeks = getActiveDisplayWeeks();
        const currentWeekData = activeWeeks.find(w => w.weekIndex === weekIndex);
        const currentPlayers = day === 'dinsdag' ? currentWeekData.dinsdag : currentWeekData.donderdag;

        for (let i = 0; i < 4; i++) {
            const select = document.getElementById(`p${i}Select`);
            const customInput = document.getElementById(`p${i}Custom`);
            
            let optionsHtml = `<option value="">-- Kies speler --</option>`;
            basePlayers.forEach(p => {
                optionsHtml += `<option value="${p}">${p}</option>`;
            });
            optionsHtml += `<option value="custom">-- Invaller (typ naam) --</option>`;
            select.innerHTML = optionsHtml;

            const assignedPlayer = currentPlayers[i] || "";
            if (basePlayers.includes(assignedPlayer)) {
                select.value = assignedPlayer;
                customInput.style.display = "none";
                customInput.value = "";
            } else if (assignedPlayer) {
                select.value = "custom";
                customInput.style.display = "block";
                customInput.value = assignedPlayer;
            } else {
                select.value = "";
                customInput.style.display = "none";
                customInput.value = "";
            }
        }

        document.getElementById("replaceModal").style.display = "flex";
    };

    window.checkCustomInputs = function() {
        for (let i = 0; i < 4; i++) {
            const select = document.getElementById(`p${i}Select`);
            const customInput = document.getElementById(`p${i}Custom`);
            if (select.value === "custom") {
                customInput.style.display = "block";
            } else {
                customInput.style.display = "none";
                customInput.value = "";
            }
        }
    };

    window.closeModal = function() {
        document.getElementById("replaceModal").style.display = "none";
    };

    window.confirmReplacement = async function() {
        let newPlayers = [];
        for (let i = 0; i < 4; i++) {
            const select = document.getElementById(`p${i}Select`);
            const customInput = document.getElementById(`p${i}Custom`);
            let val = select.value === "custom" ? customInput.value.trim() : select.value;
            if (!val) val = basePlayers[i];
            newPlayers.push(val);
        }

        // Opslaan in Firebase Realtime Database
        await db.ref(`scheduleOverrides/${currentEditingWeek}/${currentEditingDay}`).set(newPlayers);
        closeModal();
    };
</script>

</body>
</html>
